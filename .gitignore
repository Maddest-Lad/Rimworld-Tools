# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Local settings may contain secrets. Only .env-template is tracked.
.env
.env.*
!.env-template

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/settings.local.json

# MCP server local state: synced community databases, caches, snapshots, legacy SteamCMD dirs.
rimworld-mcp/bin/

# Local Notes
notes/

# Junctions into the RimWorld/Steam folders, created by bootstrap.py
links/

# Workspace
workspace/
# Log-debug test fixtures are generated by make_fixtures.py (may contain excerpts of a real Player.log)
.claude/skills/rimworld-log-debug/scripts/tests/fixtures/

# Local backups of user config files (not tracked)
backups/

# Mod-dev skill: decompiled game code (Ludeon's, reference only) and C# build output
.claude/skills/rimworld-mod-dev/.cache/
.claude/skills/rimworld-mod-dev/templates/csharp/**/bin/
.claude/skills/rimworld-mod-dev/templates/csharp/**/obj/
.claude/skills/rimworld-mod-dev/templates/csharp/1.6/

# SVG art skill: extracted vanilla textures (Ludeon's, reference only)
.claude/skills/rimworld-svg-art/.cache/
.claude/skills/rimworld-svg-art/assets/*
!.claude/skills/rimworld-svg-art/assets/README.md
