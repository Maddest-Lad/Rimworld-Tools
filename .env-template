# Copy to .env and fill in. .env is gitignored and must never be read by Claude.

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Enables workshop_search and other key-gated tools. Never echoed in tool results.
STEAM_WEB_API_KEY=

# Optional overrides (defaults shown; leave blank to use the default)
# RIMWORLD_TOOLS_STEAMCMD_PREFIX=     # default: <repo>/bin
# RIMWORLD_TOOLS_MODS_DIR=            # default: autodetected from the Steam install
# RIMWORLD_TOOLS_DB_DIR=              # default: <repo>/bin/dbs
# RIMWORLD_TOOLS_MAX_DOWNLOAD_ITEMS=  # default: 50
